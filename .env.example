# @BotFather dan olingan token
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz
# Natijalar joylanadigan kanal (bot admin, post yozish huquqi bilan)
RESULTS_CHANNEL=@kanal1
# Obuna bo'linadigan kanal va sahifalar admin paneldagi «Obunalar» bo'limida boshqariladi.
# Quyidagilar faqat birinchi ishga tushirishda o'sha bo'limga ko'chiriladi (ixtiyoriy):
# REQUIRED_CHANNELS=@kanal1,@kanal2
# FB_URL=https://facebook.com/sahifangiz
# X_URL=https://x.com/akkauntingiz
# I_URL=https://instagram.com/akkauntingiz
# Natijani kanalda yangilash oralig'i (soniya)
UPDATE_INTERVAL=15
# So'rovnoma necha kun davom etadi
POLL_DAYS=15

# Veb admin panel: http://localhost:8080
# Birinchi bosh admin (faqat adminlar jadvali bo'sh bo'lsa ishlatiladi; keyin adminlar paneldan boshqariladi)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
WEB_PORT=8080

# Docker'dagi baza paroli (serverda albatta uzun tasodifiy parol qo'ying)
POSTGRES_PASSWORD=change-me-too

# Docker ishlatsangiz DATABASE_URL ni o'zgartirish shart emas (compose o'zi beradi)
DATABASE_URL=postgresql://votes:votes@localhost:5432/votes
